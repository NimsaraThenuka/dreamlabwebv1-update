---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildBreadcrumbSchema } from '../data/structuredData';

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://dreamlabltd.jp').replace(/\/$/, '');
const jsonLd = [
  buildBreadcrumbSchema(siteUrl, [{ name: 'トップ', path: '/' }, { name: "ブログ", path: "/blog" }])
];
---

<BaseLayout
  title={"ブログ｜AI活用・経営・販路開拓のヒント｜dreamLab"}
  description={"AIの活用と経営の仕組みづくり、販路開拓・海外販売、教育・地域共創。福島県いわき市のdreamLabが、現場で役立つ考え方をお届けします。"}
  ogType={"website"}
  ogImage={"/img/blog-ai-1.jpg"}
  activeNav={"blog"}
  simpleHeader={false}
  stickyBar={false}
  noindex={false}
  isThanks={false}
  jsonLd={jsonLd}
>
<main id="main">

<section class="page-head">
<div class="wrap">
<h1 class="h1">
<span class="line">経営、販路開拓、教育の</span>
<span class="line">ヒントを発信</span>
</h1>
<p class="page-head__lead phrase">AIの活用と経営の仕組みづくり、販路開拓・海外販売、教育・地域共創。現場で役立つ考え方をお届けします。</p>
</div>
</section>

<section class="section" aria-label="記事一覧">
<div class="wrap">
<ul class="tabs" aria-label="カテゴリ">

<li><button type="button" data-tab="all" aria-pressed="true">すべて</button></li>

<li><button type="button" data-tab="ai" aria-pressed="false">AI経営支援</button></li>

<li><button type="button" data-tab="market" aria-pressed="false">販路開拓・海外販売</button></li>

<li><button type="button" data-tab="edu" aria-pressed="false">教育・地域共創</button></li>

</ul>
