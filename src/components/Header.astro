---
import { NAV_PRIMARY, NAV_SECONDARY } from '../data/site';

interface Props {
  simple?: boolean;
  activeNav?: string;
}

const { simple = false, activeNav = '' } = Astro.props;
---

{simple ? (
<header class="header header--simple">
<div class="wrap header__inner">
<a class="logo-img" href="/" aria-label="dreamLab トップへ"><img class="logo-img__mark" src="/img/logo-mark.png" alt=""><img class="logo-img__word" src="/img/logo-word.png" alt="dreamLab"></a>
</div>
</header>
) : (
<header class="header">
<div class="wrap header__inner">
<a class="logo-img" href="/" aria-label="dreamLab トップへ"><img class="logo-img__mark" src="/img/logo-mark.png" alt=""><img class="logo-img__word" src="/img/logo-word.png" alt="dreamLab"></a>
<nav class="nav" aria-label="メインメニュー">
<ul class="nav__list">
{NAV_PRIMARY.map((item) => (
<li><a href={item.href} aria-current={activeNav === item.key ? 'page' : 'false'}>{item.label}</a></li>
))}
{NAV_SECONDARY.map((item) => (
<li class={item.restFirst ? 'nav__rest-first' : ''}><a href={item.href} aria-current={activeNav === item.key ? 'page' : 'false'}>{item.label}</a></li>
))}
</ul>
<a class="btn-cta btn-cta--sm" href="/inquiry">無料相談はこちら<span class="arrow" aria-hidden="true">→</span></a>
<button class="menu-btn" type="button" aria-controls="sp-menu" aria-label="メニューを開く" aria-expanded="false">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"></path></svg>
</button>
</nav>
</div>

<div class="sp-menu" id="sp-menu" hidden>
<div class="wrap">
<ul>
{NAV_PRIMARY.map((item) => (
<li><a href={item.href} aria-current={activeNav === item.key ? 'page' : 'false'}>{item.label}</a></li>
))}
</ul>
<ul class="sp-menu__rest">
{NAV_SECONDARY.map((item) => (
<li><a href={item.href} aria-current={activeNav === item.key ? 'page' : 'false'}>{item.label}</a></li>
))}
</ul>
<a class="btn-cta" href="/inquiry">無料相談はこちら<span class="arrow" aria-hidden="true">→</span></a>
</div>
</div>
</header>
)}
