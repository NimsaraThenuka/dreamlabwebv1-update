---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildBreadcrumbSchema } from '../data/structuredData';

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://dreamlabltd.jp').replace(/\/$/, '');
const jsonLd = [
  buildBreadcrumbSchema(siteUrl, [{ name: 'トップ', path: '/' }, { name: "ご相談・お申込み", path: "/inquiry" }])
];
---

<BaseLayout
  title={"無料相談・お申込み｜dreamLab"}
  description={"30分の無料相談と90分セッションのお申込み、診断・伴走、販路開拓、教育・地域連携のご相談は、こちらのフォームから。2営業日以内にご連絡します。"}
  ogType={"website"}
  ogImage={"/img/top-hero-ceo-consult.webp"}
  activeNav={""}
  simpleHeader={false}
  stickyBar={false}
  noindex={false}
  isThanks={false}
  jsonLd={jsonLd}
>
<main id="main">
            <section class="page-head" style="border-bottom: 0; padding-bottom: 48px">
                <div class="wrap form-wrap">
                    <h1 class="h1">ご相談・お申込み</h1>
                    <p class="page-head__lead phrase">
                        30分の無料相談・90分セッションのお申込みと、その他のご相談は、こちらのフォームからお送りください。入力は1分ほどです。2営業日以内に、担当の小川からメールで日程などをご連絡します。</p>
                </div>
            </section>

            <section style="padding-bottom: var(--section)">
                <div class="wrap form-wrap">

                    <fieldset class="choice-grid">
                        <legend>ご用件</legend>

                        <button class="choice" type="button" data-type="free"
                            aria-pressed="true"><strong>30分の無料相談</strong><span>オンライン（Zoom）・無料／日程はメールで調整します</span></button>

                        <button class="choice" type="button" data-type="session"
                            aria-pressed="false"><strong>90分セッションを申し込む</strong><span>50,000円（税抜・税込55,000円）／課題の整理と30日の行動計画</span></button>

                        <button class="choice" type="button" data-type="consult"
                            aria-pressed="false"><strong>診断・伴走のご相談</strong><span>経営診断、業務効率化・仕組み化診断、伴走、経営AIパートナー</span></button>

                        <button class="choice" type="button" data-type="pilot"
                            aria-pressed="false"><strong>モニター企業について相談する</strong><span>先着3社（限定）・業務効率化・仕組み化診断をモニター価格20万円（税抜）で</span></button>

                        <button class="choice" type="button" data-type="market"
                            aria-pressed="false"><strong>販路開拓のご相談</strong><span>30分程度・無料</span></button>

                        <button class="choice" type="button" data-type="education"
                            aria-pressed="false"><strong>教育・地域連携、その他</strong><span>企画段階のご相談、取材・講演・協業など</span></button>

                    </fieldset>

                    <!-- お申込み・ご相談：フォーム -->

                    <form action="/inquiry-thanks" method="get" data-inquiry>
                        <input type="hidden" name="type" id="f-type" value="free">
                        <input type="hidden" id="utm_source" name="utm_source" value="">
                        <input type="hidden" id="utm_campaign" name="utm_campaign" value="">
                        <div class="fields">
                            <div class="field"><label for="f-company">会社名・団体名<span class="req">必須</span></label><input
                                    class="input" id="f-company" name="company" type="text" required
                                    autocomplete="organization"></div>
                            <div class="field-row">
                                <div class="field"><label for="f-name">お名前<span class="req">必須</span></label><input
                                        class="input" id="f-name" name="name" type="text" required autocomplete="name">
                                </div>
                                <div class="field"><label for="f-mail">メールアドレス<span class="req">必須</span></label><input
                                        class="input" id="f-mail" name="email" type="email" required
                                        autocomplete="email"></div>
                            </div>


                            <p class="wish__hint phrase" id="session-note" hidden>
                                お支払い方法（クレジットカード・銀行振込）は、日程確定後のメールでご案内します。キャンセル規定は<a class="inline-link"
                                    href="/cancel">キャンセル・返金規定</a>をご確認ください。</p>


                            <div class="field">
                                <label for="f-body">ご相談内容
                                    <span class="req" id="body-req" hidden>必須</span>
                                    <span class="opt" id="body-opt">任意</span>
                                </label>
                                <textarea class="textarea" id="f-body" name="message" rows="6"
                                    placeholder="今いちばん気になっていることを、一言でも結構です。ご希望の日時があれば、あわせてお書きください。"></textarea>
                            </div>

                            <label class="agree" for="f-agree"><input type="checkbox" id="f-agree" name="agree"
                                    required><span><a class="inline-link"
                                        href="/privacy">プライバシーポリシー</a>に同意する</span><span
                                    class="req">必須</span></label>
                        </div>

                        <div class="submit">
                            <button class="btn-cta" type="submit" id="f-submit">無料相談を申し込む<span class="arrow"
                                    aria-hidden="true">→</span></button>
                        </div>
                    </form>


                </div>
            </section>
        </main>
</BaseLayout>
