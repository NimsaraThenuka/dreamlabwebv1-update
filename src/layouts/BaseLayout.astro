---
import '../styles/site.css';
import '../styles/pages.css';
import '../styles/export.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  activeNav?: string;
  simpleHeader?: boolean;
  stickyBar?: false | { href?: string; label?: string; action?: string };
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  isThanks?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = SITE.defaultImage,
  activeNav = '',
  simpleHeader = false,
  stickyBar = false,
  noindex = false,
  jsonLd = [],
  isThanks = false
} = Astro.props;

const siteBase = (Astro.site ? Astro.site.toString() : 'https://dreamlabltd.jp').replace(/\/$/, '');
const cleanPathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = `${siteBase}${cleanPathname}`;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteBase}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
const schemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const gaId = import.meta.env.PUBLIC_GA_ID || '';
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || '';
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}>
<link rel="canonical" href={canonicalUrl}>
<link rel="icon" type="image/png" href="/img/logo-mark.png">
<link rel="apple-touch-icon" href="/img/logo-mark.png">
<meta property="og:type" content={ogType}>
<meta property="og:locale" content={SITE.locale}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={absoluteOgImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={absoluteOgImage}>
{gaId && (
<>
<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
<script is:inline define:vars={{ gaId, isThanks }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', gaId);
  if (isThanks) gtag('event', 'generate_lead');
</script>
</>
)}
{clarityId && (
<script is:inline define:vars={{ clarityId }}>
  (function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
  })(window, document, "clarity", "script", clarityId);
</script>
)}
{schemas.map((schema) => (
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
))}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&amp;family=Shippori+Mincho:wght@500;600&amp;family=Zen+Kaku+Gothic+New:wght@400;500;700&amp;display=swap">
</head>
<body>
<div class="site" style='width: 100%; font-family: "Zen Kaku Gothic New", "Hiragino Sans", "Yu Gothic", sans-serif; color: #1D201D'>
<a class="skip-link" href="#main">本文へスキップ</a>
<Header simple={simpleHeader} activeNav={activeNav} />
<slot />
<Footer />
{stickyBar && (
<StickyBar href={stickyBar.href} label={stickyBar.label} action={stickyBar.action} />
)}
</div>
<script src="../scripts/main.js"></script>
</body>
</html>
